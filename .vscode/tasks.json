{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test: all experiments",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pytest",
        "-q",
        "tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MPLCONFIGDIR": "${workspaceFolder}/.cache/matplotlib",
          "XDG_CACHE_HOME": "${workspaceFolder}/.cache",
          "OPENBLAS_NUM_THREADS": "1",
          "OMP_NUM_THREADS": "1",
          "VECLIB_MAXIMUM_THREADS": "1"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Environment: sync locked dependencies",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: Ruff",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "ruff",
        "check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: formatting",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "ruff",
        "format",
        "--check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: types",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pyright"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: Pylint",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pylint",
        "srclearner",
        "tests/test_mechanisms.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: all files",
      "dependsOn": [
        "Check: Ruff",
        "Check: formatting",
        "Check: types",
        "Check: Pylint"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
